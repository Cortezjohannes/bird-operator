# OAuth 1.0a user context
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# OAuth 2.0 user token set
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=

# Bearer token
X_BEARER_TOKEN=

# Client credentials
X_CLIENT_ID=
X_CLIENT_SECRET=
