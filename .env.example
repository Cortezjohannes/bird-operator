# Runtime mode
# Leave as `demo` for local development unless you intentionally want to test live auth wiring.
X_OPERATOR_CONSOLE_MODE=demo

# Optional UI label shown in live mode only.
# Use a generic local alias, not a personal handle.
X_OPERATOR_ACCOUNT_LABEL=local_demo_account

# OAuth 1.0a user context
# Required together if you want to test OAuth 1.0a actions locally.
X_APP_KEY=your_x_app_key_here
X_APP_SECRET=your_x_app_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# OAuth 2.0 user token set
# Access token is the minimum for diagnostics; refresh token is optional unless your local flow uses refresh.
X_OAUTH2_ACCESS_TOKEN=your_x_oauth2_access_token_here
X_OAUTH2_REFRESH_TOKEN=your_x_oauth2_refresh_token_here

# App bearer token
# Read-oriented diagnostics only. Do not expose this client-side.
X_BEARER_TOKEN=your_x_bearer_token_here

# Client credentials
# Keep local-only. These are modeled for future token flows and should never be committed with real values.
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
