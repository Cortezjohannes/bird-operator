# App auth and session boundary
# Required for Phase 1 public-product hardening.
APP_BASE_URL=http://localhost:3000
APP_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
APP_OWNER_EMAIL=owner@example.com
# Password hashes use the format: scrypt$SALT$HASH
# Generate locally with:
# node -e "const crypto=require('node:crypto'); const password='change-me'; const salt=crypto.randomBytes(16).toString('base64url'); crypto.scrypt(password, salt, 64, (_, key) => console.log(`scrypt$${salt}$${key.toString('base64url')}`));"
APP_OWNER_PASSWORD_HASH=scrypt$replace_salt$replace_hash
APP_SESSION_TTL_HOURS=12

# Runtime mode
# Leave as `demo` for local development unless you intentionally want to test live auth wiring.
X_OPERATOR_CONSOLE_MODE=demo

# Hosted OAuth and token encryption
# Required for durable live X account connectivity in Phase 2.
# Use a long random value; this key is used only server-side to encrypt stored X tokens at rest.
X_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Operator pairing defaults
# Short TTLs are intentional. Pairing requests and leases should not stay valid indefinitely.
OPERATOR_PAIRING_REQUEST_TTL_MINUTES=15
OPERATOR_SESSION_TTL_HOURS=24

# Optional override for OAuth scopes requested during hosted connect.
# Defaults are tweet.read users.read tweet.write like.write follows.write bookmark.write offline.access
X_OAUTH_SCOPES=

# Optional UI label shown in live mode only.
# Use a generic local alias, not a personal handle.
X_OPERATOR_ACCOUNT_LABEL=local_demo_account

# OAuth 1.0a user context
# Required together if you want to test OAuth 1.0a actions locally.
X_APP_KEY=your_x_app_key_here
X_APP_SECRET=your_x_app_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# OAuth 2.0 user token set
# Legacy/manual fallback only. The preferred live path is hosted OAuth connect through the app UI.
# Leave these empty unless you are intentionally testing an env-driven fallback setup.
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=

# App bearer token
# Read-oriented diagnostics only. Do not expose this client-side.
X_BEARER_TOKEN=your_x_bearer_token_here

# Client credentials
# Keep local-only. These are modeled for future token flows and should never be committed with real values.
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
