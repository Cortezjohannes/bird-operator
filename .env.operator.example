# Hosted Bird Operator app URL
APP_BASE_URL=https://your-app.up.railway.app

# How this remote operator should appear in the approval UI
OPERATOR_LABEL=OpenClaw VPS
OPERATOR_INSTANCE_ID=openclaw-vps-1

# Optional request metadata shown to the owner during approval
OPERATOR_RUNTIME=openclaw
OPERATOR_HOST=your-vps-hostname
OPERATOR_REGION=ap-southeast-1
OPERATOR_NOTES=Primary remote operator instance

# Optional comma-separated request set. The owner still chooses the final grants.
# Leave blank to request the standard full operator capability set.
# OPERATOR_REQUESTED_CAPABILITIES=read_timeline,read_mentions,reply_tweet,quote_tweet,post_tweet

# Optional plain-language summary shown in the approval review screen.
# OPERATOR_SCOPE_SUMMARY=Timeline triage, replies, quote drafting, and profile-safe operations
